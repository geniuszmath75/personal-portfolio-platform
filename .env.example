# --- App / Nuxt ---
# development | production
ENV=development
# Public API prefix used by the client (Pinia stores)
BASE_API_PATH=/api/v1
# Canonical public origin for SEO (og:url, canonical).
NUXT_PUBLIC_SITE_URL=

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/personal-portfolio

# --- Auth (JWT) ---
JWT_SECRET=change-me-to-a-long-random-string
# Cookie / token lifetime in seconds
JWT_LIFETIME=1200

# --- Upload storage ---
# local = write under public/uploads (dev / Docker volume)
# s3    = S3-compatible object storage (AWS S3 / Cloudflare R2 / MinIO)
UPLOAD_DRIVER=local
# Public base URL for uploaded files when using s3 (CDN or bucket URL). Leave empty for local.
UPLOAD_PUBLIC_BASE_URL=

# S3-compatible credentials
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Production Compose (`docker compose -f docker-compose.prod.yml`).

ENV=production
BASE_API_PATH=/api/v1
# Public site origin (required for SEO canonical / OG URLs)
NUXT_PUBLIC_SITE_URL=https://your-domain.com
APP_PORT=3000

# MongoDB Atlas (required). Prefer IP allowlist = VPS public IP.
NUXT_MONGO_DB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/personal-portfolio?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-string
JWT_LIFETIME=1200

# Prefer R2 / S3 in production
UPLOAD_DRIVER=s3
# Bare host (cdn.example.com) or absolute URL (https://cdn.example.com)
UPLOAD_PUBLIC_BASE_URL=https://your-cdn-or-r2-public-host

S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
